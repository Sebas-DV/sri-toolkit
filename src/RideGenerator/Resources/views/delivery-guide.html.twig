{% extends 'layouts/ride.html.twig' %}

{% block document_styles %}
        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 10px;
            color: #000;
            line-height: 1.35;
            margin: 0;
            padding: 0;
        }

        .delivery-guide-box {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 8px;
            background: #fff;
        }

        .delivery-guide-header {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-bottom: 10px;
        }

        .delivery-guide-header-left,
        .delivery-guide-header-right {
            width: 48%;
            vertical-align: top;
        }

        .delivery-guide-header-spacer {
            width: 4%;
        }

        .delivery-guide-logo-box {
            border: none;
            background: transparent;
            padding: 0;
            text-align: center;
            height: 66px;
            line-height: 66px;
            margin-bottom: 6px;
        }

        .delivery-guide-logo {
            max-width: 270px;
            max-height: 64px;
            vertical-align: middle;
        }

        .delivery-guide-no-logo {
            color: #dc2626;
            font-size: 28px;
            font-weight: bold;
            letter-spacing: 2px;
            display: inline-block;
            vertical-align: middle;
        }

        .delivery-guide-company-box {
            height: 140px;
        }

        .delivery-guide-document-box {
            height: 212px;
        }

        .delivery-guide-header-sub {
            font-size: 9px;
            font-weight: bold;
            margin-bottom: 3px;
            text-transform: uppercase;
        }

        .delivery-guide-company-title {
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .delivery-guide-ruc-title {
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 2px;
        }

        .delivery-guide-document-type {
            font-size: 15px;
            font-weight: bold;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }

        .delivery-guide-access-key {
            font-family: Courier, monospace;
            font-size: 8px;
            word-break: break-all;
        }

        .delivery-guide-line-gap {
            margin-top: 3px;
        }

        .delivery-guide-company-meta {
            margin-top: 6px;
        }

        .delivery-guide-company-meta table {
            width: 100%;
            margin-top: 2px;
        }

        .delivery-guide-company-meta tr + tr td {
            padding-top: 3px;
        }

        .delivery-guide-meta-value {
            text-align: right;
        }

        .delivery-guide-authorization-meta {
            margin-top: 5px;
        }

        .delivery-guide-barcode-box {
            text-align: center;
            padding-top: 14px;
        }

        .delivery-guide-barcode-title {
            font-size: 8px;
            margin-bottom: 2px;
        }

        .delivery-guide-barcode {
            width: 100%;
            height: 35px;
            display: block;
        }

        .delivery-guide-barcode-key {
            margin-top: 2px;
        }

        .delivery-guide-carrier-box,
        .delivery-guide-recipient-box {
            margin-bottom: 10px;
        }

        .delivery-guide-carrier-box table,
        .delivery-guide-recipient-box table,
        .delivery-guide-bottom-layout,
        .delivery-guide-additional table {
            width: 100%;
        }

        .delivery-guide-label-wide {
            width: 35%;
        }

        .delivery-guide-value-wide {
            width: 65%;
        }

        .delivery-guide-row-gap td {
            padding-top: 2px;
        }

        .delivery-guide-divider {
            border: 0;
            border-top: 1px solid #cbd5e1;
            margin: 6px 0;
        }

        .delivery-guide-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 9px;
            color: #000;
            margin-top: 8px;
            margin-bottom: 0;
        }

        .delivery-guide-table th {
            background: #f8fafc;
            color: #000;
            font-weight: bold;
            padding: 5px 6px;
            border-bottom: 1px solid #cbd5e1;
            border-right: 1px solid #cbd5e1;
            text-transform: uppercase;
            text-align: center;
        }

        .delivery-guide-table th:last-child {
            border-right: none;
        }

        .delivery-guide-table td {
            padding: 5px 6px;
            border-bottom: 1px solid #cbd5e1;
            border-right: 1px solid #cbd5e1;
            color: #000;
        }

        .delivery-guide-table td:last-child {
            border-right: none;
        }

        .delivery-guide-table tr:last-child td {
            border-bottom: none;
        }

        .delivery-guide-table th:first-child {
            border-top-left-radius: 5px;
        }

        .delivery-guide-table th:last-child {
            border-top-right-radius: 5px;
        }

        .delivery-guide-table tr:last-child td:first-child {
            border-bottom-left-radius: 5px;
        }

        .delivery-guide-table tr:last-child td:last-child {
            border-bottom-right-radius: 5px;
        }

        .delivery-guide-text-center {
            text-align: center;
        }

        .delivery-guide-bottom-left {
            width: 60%;
            vertical-align: top;
        }

        .delivery-guide-bottom-right {
            width: 40%;
            vertical-align: top;
        }

        .delivery-guide-additional {
            min-height: 80px;
        }

        .delivery-guide-additional-title {
            font-size: 11px;
            margin-bottom: 6px;
        }

        .delivery-guide-additional-label {
            width: 22%;
        }

        .delivery-guide-additional-value {
            width: 78%;
        }

        .delivery-guide-additional-row td {
            padding-top: 3px;
        }
{% endblock %}

{% block document_header %}
    {% include 'partials/delivery-guide-header.html.twig' %}
{% endblock %}

{% block content %}
    {% set carrier = data.carrier|default({}) %}
    {% set shipping = data.shipping|default({}) %}
    {% set additionalInformation = data.additional_info|default({}) %}

    <div class="delivery-guide-box delivery-guide-carrier-box">
        <table cellspacing="0" cellpadding="0">
            <tr>
                <td class="delivery-guide-label-wide"><span class="bold">Identificación (Transportista):</span></td>
                <td class="delivery-guide-value-wide">{{ carrier.identification_number|default('N/A') }}</td>
            </tr>
            <tr class="delivery-guide-row-gap">
                <td><span class="bold">Razón Social / Nombres y Apellidos:</span></td>
                <td>{{ carrier.name|default('N/A') }}</td>
            </tr>
            <tr class="delivery-guide-row-gap">
                <td><span class="bold">Placa:</span></td>
                <td>{{ carrier.plate|default('N/A') }}</td>
            </tr>
            <tr class="delivery-guide-row-gap">
                <td><span class="bold">Punto de Partida:</span></td>
                <td>{{ shipping.start_address|default('N/A') }}</td>
            </tr>
        </table>

        <div class="delivery-guide-divider"></div>

        <table cellspacing="0" cellpadding="0">
            <tr>
                <td width="25%"><span class="bold">Fecha inicio Transporte:</span></td>
                <td width="25%">{{ shipping.start_date|default('N/A') }}</td>
                <td width="25%"><span class="bold">Fecha fin Transporte:</span></td>
                <td width="25%">{{ shipping.end_date|default('N/A') }}</td>
            </tr>
        </table>
    </div>

    {% for recipient in deliveryGuideRecipients %}
        <div class="delivery-guide-box delivery-guide-recipient-box">
            <table cellspacing="0" cellpadding="0">
                <tr>
                    <td width="25%"><span class="bold">Comprobante de Venta:</span></td>
                    <td width="15%">{{ recipient.supporting_document_title|default('') }}</td>
                    <td width="25%">{{ recipient.supporting_document_number_formatted|default('') }}</td>
                    <td width="18%"><span class="bold">Fecha de Emisión:</span></td>
                    <td width="17%">{{ recipient.supporting_document_emission_date|default('-') }}</td>
                </tr>
                <tr class="delivery-guide-row-gap">
                    <td><span class="bold">Número de Autorización:</span></td>
                    <td colspan="4" class="delivery-guide-access-key">{{ recipient.supporting_document_authorization|default('-') }}</td>
                </tr>
            </table>

            <div class="delivery-guide-divider"></div>

            <table cellspacing="0" cellpadding="0">
                <tr>
                    <td width="30%"><span class="bold">Motivo Traslado:</span></td>
                    <td width="70%">{{ recipient.reason|default('N/A') }}</td>
                </tr>
                <tr class="delivery-guide-row-gap">
                    <td><span class="bold">Destino (Punto de llegada):</span></td>
                    <td>{{ recipient.destination_address|default('N/A') }}</td>
                </tr>
                <tr class="delivery-guide-row-gap">
                    <td><span class="bold">Identificación (Destinatario):</span></td>
                    <td>{{ recipient.identification_number|default('N/A') }}</td>
                </tr>
                <tr class="delivery-guide-row-gap">
                    <td><span class="bold">Razón Social / Nombres Apellidos:</span></td>
                    <td>{{ recipient.name|default('N/A') }}</td>
                </tr>
                <tr class="delivery-guide-row-gap">
                    <td><span class="bold">Documento Aduanero:</span></td>
                    <td>{{ recipient.customs_document|default('-') }}</td>
                </tr>
                <tr class="delivery-guide-row-gap">
                    <td><span class="bold">Código Establecimiento Destino:</span></td>
                    <td>{{ recipient.destination_establishment_code|default('-') }}</td>
                </tr>
                <tr class="delivery-guide-row-gap">
                    <td><span class="bold">Ruta:</span></td>
                    <td>{{ recipient.route|default('-') }}</td>
                </tr>
            </table>

            <table class="delivery-guide-table">
                <thead>
                <tr>
                    <th width="15%">Cantidad</th>
                    <th width="45%">Descripción</th>
                    <th width="20%">Código Principal</th>
                    <th width="20%">Código Auxiliar</th>
                </tr>
                </thead>
                <tbody>
                {% for detail in recipient.details|default([]) %}
                    <tr>
                        <td class="delivery-guide-text-center">{{ detail.quantity|default('') }}</td>
                        <td>{{ detail.description|default('') }}</td>
                        <td class="delivery-guide-text-center">{{ detail.main_code|default('-') }}</td>
                        <td class="delivery-guide-text-center">{{ detail.auxiliary_code|default('-') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="delivery-guide-text-center">Sin productos registrados</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="delivery-guide-box delivery-guide-recipient-box delivery-guide-text-center">
            Sin destinatarios registrados
        </div>
    {% endfor %}

    <table class="delivery-guide-bottom-layout" cellspacing="0" cellpadding="0">
        <tr>
            <td class="delivery-guide-bottom-left">
                <div class="delivery-guide-box delivery-guide-additional">
                    <div class="bold delivery-guide-additional-title">Información Adicional</div>
                    <table cellspacing="0" cellpadding="0">
                        {% if additionalInformation is mapping %}
                            {% for name, value in additionalInformation %}
                                <tr class="{{ not loop.first ? 'delivery-guide-additional-row' : '' }}">
                                    <td class="delivery-guide-additional-label"><span class="bold">{{ name }}:</span></td>
                                    <td class="delivery-guide-additional-value">{{ value }}</td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            {% for info in additionalInformation %}
                                <tr class="{{ not loop.first ? 'delivery-guide-additional-row' : '' }}">
                                    <td class="delivery-guide-additional-label"><span class="bold">{{ info.name|default('') }}:</span></td>
                                    <td class="delivery-guide-additional-value">{{ info.value|default('') }}</td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </table>
                </div>
            </td>
            <td class="delivery-guide-bottom-right">&nbsp;</td>
        </tr>
    </table>
{% endblock %}
