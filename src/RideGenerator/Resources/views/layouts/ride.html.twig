<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <!--
        Dompdf implementa CSS 2.1. Para conservar un RIDE estable y predecible:
        - Los layouts principales se construyen con tablas.
        - Los anchos se expresan en porcentajes o milímetros.
        - Las imágenes se proporcionan como rutas locales autorizadas o data URI.
    -->
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 7.6pt;
            color: #000;
            line-height: 1.3;
        }

        table { border-collapse: collapse; }
        td, th { vertical-align: top; }

        .bold { font-weight: bold; }
        .center { text-align: center; }
        .right { text-align: right; }
        .up { text-transform: uppercase; }
        .nowrap { white-space: nowrap; }
        .spacer, .gap { height: 2.5mm; font-size: 2pt; line-height: 2pt; }

        /* Logo */
        .logo { text-align: center; padding: 2mm 0 3mm 0; }
        .logo img { width: 55mm; }
        .nologo {
            color: #FF0000;
            font-weight: bold;
            font-size: 18pt;
            text-align: center;
            padding: 6mm 0;
        }

        /* Caja con borde: tabla de una sola celda (td.fcell).
           El borde va en el td, no en la tabla: mPDF no dibuja bordes
           de tabla cuando está anidada dentro de otra tabla. */
        .frame { width: 100%; }
        .frame td.fcell { border: 0.4mm solid #000; padding: 3mm; }
        .frame td.panel-head {
            background: #e9e9e9;
            font-weight: bold;
            text-align: center;
            padding: 1.2mm;
            border: 0.4mm solid #000;
            border-bottom: 0.3mm solid #8a8a8a;
        }
        .frame td.panel-body { border: 0.4mm solid #000; padding: 2mm; }

        /* Caja de datos (otros comprobantes): div.box + table.plain */
        .box { margin-bottom: 2.5mm; }
        .plain { width: 100%; border: 0.4mm solid #000; }
        .plain td { padding: 1.5mm 2mm; }

        /* key/value plain tables */
        .kv { width: 100%; }
        .kv td { padding: 0.5mm 0; }
        .kv td.k { font-weight: bold; }

        /* Caja del comprobante (derecha) */
        .doc .ruc { font-size: 9.5pt; }
        .doc .doctitle { font-size: 11pt; font-weight: bold; margin: 1.6mm 0; }
        .doc .label { font-weight: bold; }
        .doc .auth { font-size: 6.6pt; line-height: 1.25; }
        .doc .barcode { text-align: center; }
        .doc .barcode img { width: 80mm; height: 12mm; }
        .doc .clave { font-size: 6.8pt; text-align: center; }

        /* Buyer box */
        .buyer { width: 100%; border: 0.4mm solid #000; }
        .buyer td { padding: 1mm 2mm; }
        .buyer td.k { font-weight: bold; width: 20%; }
        .buyer td.v { width: 30%; }

        /* Items table */
        .items { width: 100%; margin-top: 2.5mm; }
        .items th {
            background: #e9e9e9;
            border: 0.25mm solid #7d7d7d;
            padding: 1.2mm 1mm;
            font-size: 6.6pt;
            font-weight: bold;
            text-align: center;
        }
        .items td {
            border: 0.25mm solid #9a9a9a;
            padding: 1.1mm 1mm;
            font-size: 6.8pt;
            text-align: center;
        }
        .items td.desc { text-align: left; }
        .items td.num { text-align: right; }

        /* Generic grid table (credit/debit notes, guides, withholdings) */
        .data-table { width: 100%; }
        .data-table th {
            background: #e9e9e9;
            border: 0.25mm solid #7d7d7d;
            padding: 1.2mm 1mm;
            font-size: 6.8pt;
            font-weight: bold;
            text-align: center;
        }
        .data-table td {
            border: 0.25mm solid #9a9a9a;
            padding: 1.1mm 1mm;
            font-size: 6.9pt;
            text-align: center;
        }

        .pay { width: 100%; margin-top: 2.5mm; }
        .pay th {
            background: #e9e9e9;
            border: 0.3mm solid #8a8a8a;
            padding: 1.2mm;
            font-size: 6.8pt;
            text-align: center;
        }
        .pay td { border: 0.3mm solid #9a9a9a; padding: 1.2mm; font-size: 6.8pt; }

        .totals { width: 100%; }
        .totals td {
            border: 0.3mm solid #9a9a9a;
            padding: 1.1mm 2mm;
            font-size: 6.9pt;
        }
        .totals td.k { text-align: left; }
        .totals td.v { text-align: right; width: 30%; }
        .totals tr.grand td { font-weight: bold; background: #f0f0f0; }

        {% block document_styles %}{% endblock %}
    </style>
</head>
<body>
{% block document_header %}
    {% include 'partials/header.html.twig' %}
{% endblock %}
{% block content %}{% endblock %}
</body>
</html>
