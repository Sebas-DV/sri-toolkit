{% set tradeName = company.trade_name|default('') %}
{% set legalName = company.legal_name|default('') %}
{% set headOffice = company.head_office_address|default('') %}
{% set branch = data.establishment_address|default(company.establishment_address|default('')) %}
{% set special = data.special_taxpayer_number|default(company.special_taxpayer_number|default('')) %}
{% set accounting = data.requires_accounting|default(company.requires_accounting|default('NO')) %}
{% set withholdingAgent = data.withholding_agent_resolution|default(company.withholding_agent_resolution|default(company.withholding_agent|default(''))) %}
{% set rimpe = data.rimpe_label|default(company.rimpe_label|default(company.rimpe_regime_taxpayer|default(''))) %}

<table class="withholding-receipt-header">
    <tr>
        <td class="withholding-receipt-header-left">
            <div class="withholding-receipt-logo-box">
                {% if companyLogo %}
                    <img src="{{ companyLogo }}" class="withholding-receipt-logo" alt="Logo">
                {% else %}
                    <span class="withholding-receipt-no-logo">NO LOGO</span>
                {% endif %}
            </div>

            <div class="withholding-receipt-box withholding-receipt-company-box">
                <div class="withholding-receipt-header-sub">{{ legalName }}</div>

                {% if tradeName and tradeName != legalName %}
                    <div class="withholding-receipt-company-title">{{ tradeName }}</div>
                {% endif %}

                <div>
                    <span class="bold">Dirección Matriz:</span>
                    {{ headOffice }}
                </div>
                <div class="withholding-receipt-line-gap">
                    <span class="bold">Dirección Sucursal:</span>
                    {{ branch }}
                </div>

                <div class="withholding-receipt-company-meta">
                    {% if special %}
                        <div><span class="bold">Contribuyente Especial Nro:</span> {{ special }}</div>
                    {% endif %}

                    <table>
                        <tr>
                            <td><span class="bold">OBLIGADO A LLEVAR CONTABILIDAD:</span></td>
                            <td class="withholding-receipt-meta-value bold">{{ accounting }}</td>
                        </tr>
                        {% if withholdingAgent %}
                            <tr>
                                <td><span class="bold">Agente de Retención Resolución No.:</span></td>
                                <td class="withholding-receipt-meta-value bold">{{ withholdingAgent }}</td>
                            </tr>
                        {% endif %}
                        {% if rimpe %}
                            <tr>
                                <td><span class="bold">Contribuyente Régimen RIMPE:</span></td>
                                <td class="withholding-receipt-meta-value bold">{{ rimpe }}</td>
                            </tr>
                        {% endif %}
                    </table>
                </div>
            </div>
        </td>

        <td class="withholding-receipt-header-spacer">&nbsp;</td>

        <td class="withholding-receipt-header-right">
            <div class="withholding-receipt-box withholding-receipt-document-box">
                <div class="withholding-receipt-ruc-title">R.U.C.: {{ company.ruc|default('') }}</div>
                <div class="withholding-receipt-document-type">{{ documentTitle }}</div>
                <div><span class="bold">No.:</span> {{ documentNumber }}</div>

                <div class="withholding-receipt-line-gap"><span class="bold">NÚMERO DE AUTORIZACIÓN:</span></div>
                <div class="withholding-receipt-access-key">{{ authorizationNumber|default(accessKey) }}</div>

                <div class="withholding-receipt-authorization-meta">
                    <div><span class="bold">FECHA Y HORA DE AUTORIZACIÓN:</span> {{ authorizationDate|default('') }}</div>
                    <div><span class="bold">AMBIENTE:</span> {{ environmentLabel }}</div>
                    <div><span class="bold">EMISIÓN:</span> {{ emissionLabel }}</div>
                </div>

                <div class="withholding-receipt-barcode-box">
                    <div class="bold withholding-receipt-barcode-title">CLAVE DE ACCESO</div>
                    <img src="{{ accessKeyBarcode }}" class="withholding-receipt-barcode" alt="Código de barras">
                    <div class="withholding-receipt-access-key withholding-receipt-barcode-key">{{ accessKey }}</div>
                </div>
            </div>
        </td>
    </tr>
</table>
