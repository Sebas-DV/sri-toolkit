{% set tradeName = company.trade_name|default('') %}
{% set legalName = company.legal_name|default('') %}
{% set headOffice = company.head_office_address|default('') %}
{% set branch = data.establishment_address|default(company.establishment_address|default('')) %}
{% set special = data.special_taxpayer_number|default(company.special_taxpayer_number|default('')) %}
{% set accounting = data.requires_accounting|default(company.requires_accounting|default('NO')) %}
{% set withholdingAgent = data.withholding_agent_resolution|default(company.withholding_agent|default('')) %}
{% set rimpe = data.rimpe_label|default(company.rimpe_regime_taxpayer|default('')) %}
{% set logo = company.logo_base64|default(company.logo_path|default('')) %}

<table style="width: 100%;">
    <tr>
        <td style="width: 51%; padding-right: 2mm; vertical-align: top;">
            <table style="width: 100%;">
                <tr>
                    <td class="logo">
                        {% if logo %}
                            <img src="{{ logo }}" alt="Logo">
                        {% else %}
                            <div class="nologo">NO LOGO</div>
                        {% endif %}
                    </td>
                </tr>
            </table>

            <table class="frame">
                <tr>
                    <td class="fcell">
                        <div class="up" style="margin-bottom: 1.5mm;">{{ legalName }}</div>
                        {% if tradeName and tradeName != legalName %}
                            <div class="bold up" style="font-size: 8.6pt; margin-bottom: 2mm;">{{ tradeName }}</div>
                        {% endif %}

                        <table class="kv">
                            <tr>
                                <td class="k" style="width: 34%;">Dirección Matriz:</td>
                                <td class="up">{{ headOffice }}</td>
                            </tr>
                            <tr>
                                <td class="k">Dirección Sucursal:</td>
                                <td class="up">{{ branch }}</td>
                            </tr>
                            {% if special %}
                                <tr>
                                    <td class="k">Contribuyente Especial Nro:</td>
                                    <td>{{ special }}</td>
                                </tr>
                            {% endif %}
                            <tr>
                                <td class="k">OBLIGADO A LLEVAR CONTABILIDAD:</td>
                                <td>{{ accounting }}</td>
                            </tr>
                            {% if withholdingAgent %}
                                <tr>
                                    <td class="k">Agente de Retención Resolución No.:</td>
                                    <td>{{ withholdingAgent }}</td>
                                </tr>
                            {% endif %}
                            {% if rimpe %}
                                <tr>
                                    <td class="k">Contribuyente Régimen RIMPE:</td>
                                    <td>{{ rimpe }}</td>
                                </tr>
                            {% endif %}
                        </table>
                    </td>
                </tr>
            </table>
        </td>

        <td style="width: 49%; vertical-align: top;">
            <table class="frame">
                <tr>
                    <td class="fcell doc">
                        <div class="ruc"><span class="bold">R.U.C.:</span> {{ company.ruc|default('') }}</div>
                        <div class="doctitle">{{ documentTitle }}</div>
                        <div style="margin-bottom: 2mm;"><span class="bold">No.</span> {{ documentNumber }}</div>

                        <div class="label">NÚMERO DE AUTORIZACIÓN</div>
                        <div class="auth" style="margin-bottom: 2mm;">{{ authorizationNumber|default(accessKey) }}</div>

                        <table class="kv" style="margin-bottom: 1.5mm;">
                            <tr>
                                <td class="k" style="width: 52%;">FECHA Y HORA DE AUTORIZACIÓN:</td>
                                <td>{{ authorizationDate|default('') }}</td>
                            </tr>
                        </table>

                        <div><span class="bold">AMBIENTE:</span> {{ data.environment_label|default('PRUEBAS') }}</div>
                        <div style="margin-bottom: 2mm;"><span class="bold">EMISIÓN:</span> {{ data.emission_label|default('NORMAL') }}</div>

                        <div class="label" style="margin-bottom: 1mm;">CLAVE DE ACCESO</div>
                        <div class="barcode"><img src="{{ accessKeyBarcode }}" alt="Código de barras"></div>
                        <div class="clave">{{ accessKey }}</div>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
