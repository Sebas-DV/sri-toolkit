{
    "name": "matiz-studio-creative/sri-toolkit",
    "type": "library",
    "license": "MIT",
    "description": "PHP toolkit for Ecuador SRI electronic documents: access keys, XML builders, XAdES-BES signing and SOAP delivery.",
    "keywords": [
        "sri",
        "sri-ecuador",
        "sri-xml",
        "ecuador",
        "servicio-de-rentas-internas",
        "facturacion-electronica",
        "factura-electronica",
        "electronic-invoicing",
        "comprobantes-electronicos",
        "clave-acceso",
        "modulo-11",
        "xades-bes",
        "pkcs12",
        "soap",
        "xml",
        "factura",
        "nota-credito",
        "nota-debito",
        "guia-remision",
        "comprobante-retencion"
    ],
    "homepage": "https://sri-toolkit.matizstudiocreative.com",
    "autoload": {
        "psr-4": {
            "MTZ\\Toolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MTZ\\Toolkit\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sebastian Borja",
            "email": "sebastianborja56@gmail.com",
            "role": "Developer",
            "homepage": "https://matizstudiocreative.com"
        }
    ],
    "minimum-stability": "stable",
    "support": {
        "docs": "https://sri-toolkit.matizstudiocreative.com",
        "issues": "https://github.com/Sebas-DV/sri-toolkit/issues",
        "source": "https://github.com/Sebas-DV/sri-toolkit"
    },
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-soap": "*",
        "aws/aws-sdk-php": "^3.381",
        "dompdf/dompdf": "^3.1",
        "picqer/php-barcode-generator": "^3.2",
        "ramsey/uuid": "^4.9",
        "twig/twig": "^3.26"
    },
    "scripts": {
        "test": "phpunit",
        "test:deprecations": "phpunit --display-deprecations",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage",
        "rector": "rector process",
        "rector:test": "rector process --dry-run",
        "cs": "php-cs-fixer fix --diff --verbose",
        "cs:test": "php-cs-fixer check --diff --verbose",
        "stan": "phpstan analyse --memory-limit=1G",
        "stan:baseline": "phpstan analyse --generate-baseline",
        "ride:preview": "php -S 127.0.0.1:8088 examples/ride-preview.php",
        "analyze": [
            "@cs:test",
            "@rector:test",
            "@test",
            "@stan"
        ],
        "fix": [
            "@rector",
            "@cs"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.55",
        "rector/rector": "^2.4"
    }
}
