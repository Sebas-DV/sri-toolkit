{
    "name": "matiz-studio-creative/sri-toolkit",
    "type": "library",
    "license": "MIT",
    "description": "PHP Toolkit for SRI Web Services.",
    "autoload": {
        "psr-4": {
            "MTZ\\Toolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MTZ\\Toolkit\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sebastian Borja",
            "email": "sebastianborja56@gmail.com",
            "role": "Developer",
            "homepage": "https://matizstudiocreative.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-soap": "*",
        "ramsey/uuid": "^4.9",
        "ext-openssl": "*",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "scripts": {
        "test": "phpunit",
        "test:deprecations": "phpunit --display-deprecations",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage",
        "rector": "rector process",
        "rector:test": "rector process --dry-run",
        "cs": "php-cs-fixer fix --diff --verbose",
        "cs:test": "php-cs-fixer check --diff --verbose",
        "stan": "phpstan analyse --memory-limit=1G",
        "stan:baseline": "phpstan analyse --generate-baseline",
        "analyze": [
            "@cs:test",
            "@rector:test",
            "@test",
            "@stan"
        ],
        "fix": [
            "@rector",
            "@cs"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.55",
        "rector/rector": "^2.4"
    }
}
